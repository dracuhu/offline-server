# Meta Graph API credentials. Never put these in frontend code or commit .env.
META_PAGE_ACCESS_TOKEN=replace_with_page_access_token
INSTAGRAM_ACCOUNT_ID=replace_with_instagram_professional_account_id
GRAPH_API_VERSION=v27.0
# Set a long random value to protect the dashboard with HTTP Basic Auth.
DASHBOARD_PASSWORD=change_this_to_a_long_random_password
PORT=10000
